# LLM Configuration
OPENAI_API_BASE=http://192.168.192.70:3030/v1
OPENAI_API_KEY=sk-placeholder
STOCKER_DEEP_THINK_MODEL=gpt-4o
STOCKER_QUICK_THINK_MODEL=gpt-4o

# Scheduler (cron expressions)
STOCKER_SCAN_CRON=0 9 * * 1-5          # 每个交易日09:00扫描持仓
STOCKER_SYNC_INTERVAL_MINUTES=5          # 每5分钟同步券商持仓
STOCKER_REPORT_CRON=0 16 * * 1-5        # 每个交易日16:00生成日报
STOCKER_REFLECT_CRON=30 16 * * 1-5      # 每个交易日16:30触发反思

# Service
STOCKER_API_HOST=127.0.0.1
STOCKER_API_PORT=8000
STOCKER_DATA_DIR=data

# Auto Trading
STOCKER_AUTO_TRADING_ENABLED=false
STOCKER_CONFIDENCE_THRESHOLD=0.7

# Broker: futu / simulated / backtest
# - futu: 连接 Futu OpenD（需要 OpenD 运行）
# - simulated: 纯内存模拟盘（无需 OpenD）
# - backtest: 历史回测模式（无需 OpenD）
STOCKER_BROKER_TYPE=simulated
STOCKER_EXECUTION_MODE=active

# Futu OpenD
STOCKER_FUTU_HOST=127.0.0.1
STOCKER_FUTU_PORT=11111
STOCKER_FUTU_TRD_ENV=simulate
STOCKER_FUTU_MARKET=HK
STOCKER_FUTU_TRADE_PWD=
STOCKER_FUTU_QUOTE_ENABLED=true
STOCKER_FUTU_SUBSCRIBE_CODES=